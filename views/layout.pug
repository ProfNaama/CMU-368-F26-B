doctype html
html
  head
    title= title 
    link(rel="stylesheet", href="/static/stylesheets/style.css")
  body
    div(class="container")
      div(class="header")
        h2
      div(class="left" )
        h2
      div(class="content" )
        if progress_step
          div(class="progress")
            div(class="progress-label") Step #{progress_step} of #{progress_total}: #{progress_name}
            div(class="progress-track")
              div(class="progress-fill" style="width: " + Math.round(progress_step / progress_total * 100) + "%")
        if header_message
          h2(class="controlled_header")!=header_message
        if body_message
          div(class="controlled_body")!=body_message

        block content
      div(class="footer" )
        h2

